{
	"name": "PL_Controller_AutoOnboarding",
	"properties": {
		"activities": [
			{
				"name": "Lookup_SourceTables",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": "\nSELECT\n    TABLE_SCHEMA AS SchemaName,\n    TABLE_NAME AS TableName\nFROM INFORMATION_SCHEMA.TABLES\nWHERE TABLE_TYPE = 'BASE TABLE'\n  AND TABLE_SCHEMA = 'dbo'\n  AND TABLE_NAME NOT IN\n  (\n      'ETL_Metadata',\n      'ETL_Metadata_Backup',\n      'ETL_RunLog',\n      'Numbers'\n  )\nORDER BY TABLE_NAME;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQLServer_Discovery",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Lookup_ControlMetadata",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT\n    SchemaName,\n    TableName\nFROM dbo.ETL_Metadata\nWHERE IsActive = 1\nORDER BY TableName;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSQL_ControlMetadata",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Filter_NewTables",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "Lookup_ControlMetadata",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Lookup_SourceTables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup_SourceTables').output.value",
						"type": "Expression"
					},
					"condition": {
						"value": "@not(\n    contains(\n        string(activity('Lookup_ControlMetadata').output.value),\n        concat('\"TableName\":\"', item().TableName, '\"')\n    )\n)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "ForEach_NewTables",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Filter_NewTables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Filter_NewTables').output.value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "SP_InsertMetadata",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "dbo.usp_InsertMetadata",
								"storedProcedureParameters": {
									"SchemaName": {
										"value": {
											"value": "@item().SchemaName",
											"type": "Expression"
										},
										"type": "String"
									},
									"TableName": {
										"value": {
											"value": "@item().TableName",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_AzureSQL_ControlDB",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			},
			{
				"name": "Execute_ETL_Pipeline",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "ForEach_NewTables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_SQLServer_ADLS_Incremental_and_full",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-09-12T12:13:23Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}